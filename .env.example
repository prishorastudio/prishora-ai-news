# Existing credentials
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BLOGGER_BLOG_ID=

# Phase 3 operating mode: draft | publish | local
PIPELINE_MODE=draft

# Editorial controls
MINIMUM_QA_SCORE=90
MINIMUM_H2_COUNT=2
MINIMUM_WORD_COUNT=700
MAXIMUM_WORD_COUNT=1800
MAXIMUM_STORY_AGE_HOURS=72
APPROVED_TOPICS=
BLOCKED_TOPICS=rumor,giveaway,sponsored

# Duplicate and publishing limits
DUPLICATE_SIMILARITY_THRESHOLD=0.72
MINIMUM_MINUTES_BETWEEN_POSTS=180
MAXIMUM_POSTS_PER_DAY=3

# Retry controls
RETRY_ATTEMPTS=2
RETRY_DELAY_MS=1500

# Scheduler uses the computer's local timezone
SCHEDULE_TIMES=09:00,18:00

DEBUG=false
